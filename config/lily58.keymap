/*
 * Sina's Lily58 keymap, ported from the Lulu QMK keymap
 * (docs/qmk-src/keymap.c and lulu_sina_keymap_cheatsheet_plain_english.html).
 *
 * Rows: 12 / 12 / 12 / 14 (L1-L6, inner left, inner right, R1-R6) / 8 thumbs
 * (T1-T4 left outer to inner, T5-T8 right inner to outer).
 *
 * Knobs: sensor-bindings are <left right>, first value = clockwise.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define GAME 1
#define SYM  2
#define NUM  3
#define ADJ  4
#define NAV  5

/* ADJUST is a one-shot like QMK's OSL, which never timed out; give it a minute */
&sl {
    release-after-ms = <60000>;
};

/ {
    behaviors {
        /* Home-row and thumb mods. Balanced = QMK PERMISSIVE_HOLD: F held while
         * another key is tapped resolves as Ctrl (Ctrl+C, not "fc"). */
        hm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        /* One wheel step per knob click: &msc only scrolls while held, so hold
         * it 20 ms (one 16 ms tick) at a speed that rounds to one step */
        scroll_enc: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc MOVE_Y(-70)>, <&msc MOVE_Y(70)>;
            tap-ms = <20>;
        };

        hue_enc: hue_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;
        };

        sat_enc: sat_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_SAI>, <&rgb_ug RGB_SAD>;
        };

        spd_enc: speed_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_SPI>, <&rgb_ug RGB_SPD>;
        };

        bri_enc: brightness_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESC    &kp N1       &kp N2  &kp N3       &kp N4        &kp N5                              &kp N6  &kp N7        &kp N8       &kp N9  &kp N0        &kp BSPC
&kp TAB    &kp Q        &kp W   &kp E        &kp R         &kp T                               &kp Y   &kp U         &kp I        &kp O   &kp P         &kp MINUS
&kp GRAVE  &hm LGUI A   &kp S   &hm LALT D   &hm LCTRL F   &kp G                               &kp H   &hm LCTRL J   &hm LALT K   &kp L   &hm RGUI SEMI &kp SQT
&kp LCTRL  &kp Z        &kp X   &kp C        &kp V         &kp B    &kp C_PP      &kp CAPS     &kp N   &kp M         &kp COMMA    &kp DOT &kp FSLH      &kp EQUAL
                        &mkp LCLK  &tog NUM  &mo NAV  &hm LSHFT SPACE                   &hm LSHFT RET  &mo SYM  &kp DEL  &sl ADJ
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &scroll_enc>;
        };

        game_layer {
            display-name = "GAME";
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                          &kp N6  &kp N7  &kp N8    &kp N9  &kp N0   &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                           &kp Y   &kp U   &kp I     &kp O   &kp P    &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                           &kp H   &kp J   &kp K     &kp L   &kp SEMI &kp EQUAL
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V   &kp B   &kp H       &to BASE    &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH &kp RET
                   &kp F1  &kp F2  &kp LALT  &kp SPACE                     &kp Y   &mo NUM  &kp K  &kp BSLH
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_NEXT C_PREV>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp F1             &kp F2         &kp F3           &kp F4                &kp F5                                                  &kp F6          &kp F7          &kp F8      &kp F9     &kp F10  &kp F11
&trans  &kp LA(LG(SPACE))  &none          &kp LA(PSCRN)    &kp PSCRN             &none                                                   &kp ASTRK       &kp PLUS        &kp LPAR    &kp RPAR   &none    &kp F12
&none   &none              &none          &none            &kp LC(LS(LG(M)))     &rgb_ug RGB_EFS_CMD 1                                   &kp CARET       &kp EQUAL       &kp LBKT    &kp RBKT   &kp LT   &kp GT
&trans  &rgb_ug RGB_SPD    &rgb_ug RGB_SPI &rgb_ug RGB_BRD &rgb_ug RGB_BRI       &rgb_ug RGB_EFS_CMD 0  &rgb_ug RGB_TOG  &trans          &rgb_ug RGB_EFR &rgb_ug RGB_EFF &none       &none      &kp BSLH &kp RET
                           &trans         &trans           &trans                &trans                                  &trans          &trans          &trans      &trans
            >;
            sensor-bindings = <&hue_enc &sat_enc>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F9                                &none   &kp KP_NUMLOCK &kp KP_SLASH &kp KP_ASTERISK &kp KP_MINUS &trans
&trans     &none   &none   &none   &none   &kp F11                               &none   &kp N7         &kp N8       &kp N9          &kp KP_PLUS  &none
&kp GRAVE  &none   &none   &none   &none   &none                                 &none   &kp N4         &kp N5       &kp N6          &kp KP_PLUS  &none
&kp LCTRL  &none   &none   &none   &kp F8  &kp F5   &kp C_MUTE      &none        &kp N0  &kp N1         &kp N2       &kp N3          &kp KP_DOT   &kp RET
                   &trans  &trans  &kp LALT  &trans                              &trans  &trans  &trans  &trans
            >;
            /* Right knob left out on purpose: an unassigned sensor falls
             * through to the layer below (&trans isn't valid for sensors) */
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV>;
        };

        adj_layer {
            display-name = "ADJUST";
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans                          &trans     &trans     &trans     &trans     &trans     &to GAME
&trans  &trans  &trans     &kp F4     &kp F5     &kp F6                          &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
&trans  &trans  &trans     &kp HASH   &kp DLLR   &kp PRCNT                       &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp TILDE
&trans  &trans  &kp LC(X)  &kp LC(C)  &kp LC(V)  &trans    &trans      &trans    &none      &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE
                &trans     &trans     &trans     &trans                          &trans     &trans     &trans     &trans
            >;
            sensor-bindings = <&spd_enc &bri_enc>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4           &kp F5                             &kp F6  &kp F7    &kp F8    &kp F9     &kp F10   &kp F11
&none         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &bt BT_SEL 4                       &none   &kp HOME  &kp UP    &kp END    &kp PG_UP &kp F12
&kp GRAVE     &trans        &none         &trans        &trans           &none                              &none   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN &none
&bt BT_CLR    &out OUT_TOG  &none         &none         &kp LS(LG(V))    &none   &kp C_MUTE     &trans      &none   &none     &none     &none      &kp BSLH  &kp RET
                            &mkp RCLK     &none         &none            &trans                             &kp SPACE  &none  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp PG_DN PG_UP>;
        };
    };
};
